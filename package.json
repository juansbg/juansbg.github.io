{
  "name": "omerta",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Narrator assistant for Omertà, a social deduction party game",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "node scripts/sim.mjs",
    "typecheck": "tsc --noEmit",
    "relay:dev": "wrangler dev -c relay/wrangler.toml --port 8787",
    "relay:deploy": "wrangler deploy -c relay/wrangler.toml",
    "relay:check": "tsc --noEmit -p relay"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260904.1",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.129.0"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "qrcode-generator": "^2.0.4"
  }
}
